# ==============================================================================
# HomeSyncAI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (in the Backend directory for backend settings)
# 2. Replace the placeholder values with your real configuration.
# 3. DO NOT commit actual '.env' files or credentials into version control.
# ==============================================================================

# Django Secret Key (required in production; generate a secure 50+ char random string)
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production

# Debug Mode: Set to False in production, True for local development
DEBUG=True

# Allowed Hosts: Comma-separated list of host/domain names this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Connection URL:
# - Leave empty or commented out to fall back to the local SQLite database (db.sqlite3)
# - Set for PostgreSQL (local, Docker, or managed cloud like AWS RDS, Neon, Supabase, Render)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/homesyncai_db

# CORS Allowed Origins: Comma-separated list of frontend URLs permitted to make requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
