# ==============================================================================
# HomeSyncAI - Root Environment Configuration Template
# ==============================================================================
# See Backend/.env.example for backend-specific settings.
# See Frontend/.env for frontend Vite settings (VITE_API_URL).

# Backend Django & PostgreSQL Configuration
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/homesyncai_db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
# VITE_API_URL=http://127.0.0.1:8000/api
